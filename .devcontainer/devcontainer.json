{
  "name": "ROS 2 Workspace",
  "remoteUser": "rosdev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "rosdev"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
      ]
    }
  },
  "containerEnv": {
    "DISPLAY": "unix:0",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
    "ROS_DOMAIN_ID": "42"
  },
  "workspaceFolder": "/home/rosdev/ros2_ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/rosdev/ros2_ws/,type=bind",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/rosdev/.ssh,type=bind,consistency=cached",
    "source=/dev,target=/dev,type=bind"
  ],
  "runArgs": [
    "--net=host",
    "--pid=host",
    "--ipc=host",
    "--name",
    "ur12e_persistent",
    "--restart=unless-stopped",
    "-e",
    "DISPLAY=${env:DISPLAY}",
    "--device-cgroup-rule=c 81:* rmw",
    "--device-cgroup-rule=c 189:* rmw"
  ],
  "overrideCommand": false
}
